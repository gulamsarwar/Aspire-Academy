# ==============================================================================
# ASPIRE ACADEMY ONLINE — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================

# NEXT.JS APPLICATION SETTINGS
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Aspire Academy"

# SUPABASE CONFIGURATION
# Obtain these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key is strictly used in backend Route Handlers / Webhooks. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# RAZORPAY PAYMENT GATEWAY
# Obtain these from: Razorpay Dashboard -> Settings -> API Keys (Use Test Mode keys for development)
# Test Mode Key starts with 'rzp_test_'
# Live Mode Key starts with 'rzp_live_'
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# RAZORPAY WEBHOOK SECRET
# Configure in: Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
# Webhook URL: https://your-domain.com/api/webhooks/razorpay
# Secret: Enter a strong random secret phrase here and in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=YourCustomWebhookSecretPhraseHere

# ACADEMY CONTACT & NOTIFICATIONS
NEXT_PUBLIC_CONTACT_PHONE="+91 9876543210"
NEXT_PUBLIC_CONTACT_EMAIL="contact@aspireacademyonline.in"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
