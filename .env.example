# ==============================================================================
# ASPIRE ACADEMY ONLINE — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.local' for local development:
#    cp .env.example .env.local
# 2. Never commit '.env.local' or any file containing real secrets to Git.
# 3. For production deployments (Vercel, Hostinger, etc.), set these variables
#    directly in your hosting provider's Environment Variables dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CANONICAL APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# In local development: http://localhost:3000
# In production: Your live custom domain or hosting URL (e.g., https://aspireacademyonline.in)
# NOTE: Never put localhost in production!
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Aspire Academy Online"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTHENTICATION
# ------------------------------------------------------------------------------
# Obtain from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# SERVER-ONLY: Used exclusively by secure server-side API routes & webhooks.
# NEVER prefix with NEXT_PUBLIC_ and NEVER expose in frontend client code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Obtain from: Razorpay Dashboard -> Settings -> API Keys
# Development: Use Test Key (starts with 'rzp_test_')
# Production: Use Live Key (starts with 'rzp_live_')
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyIdHere
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# RAZORPAY WEBHOOK SECRET
# Configure in: Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
# Webhook URL: https://your-production-domain.com/api/webhooks/razorpay
# Active Events: order.paid, payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=your-random-webhook-secret-phrase-here

# ------------------------------------------------------------------------------
# 4. FACULTY / ADMIN PORTAL ACCESS (/admin)
# ------------------------------------------------------------------------------
# Comma-separated list of authorized administrator email addresses
ADMIN_EMAILS=aspireacademyamba@gmail.com,admin@aspireacademy.in

# Master password for admin portal login at /admin/login
ADMIN_PASSWORD=YourStrongAdminPassword2026!

# Cryptographic secret for signing admin session tokens (min 32 characters)
ADMIN_SESSION_SECRET=generate-a-strong-32-character-secret-key-here

# ------------------------------------------------------------------------------
# 5. ACADEMY CONTACT & STUDENT SUPPORT
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_PHONE="+91 9876543210"
NEXT_PUBLIC_CONTACT_EMAIL="contact@aspireacademyonline.in"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# ------------------------------------------------------------------------------
# 6. (OPTIONAL) CLOUDFLARE R2 PRIVATE VIDEO STORAGE
# ------------------------------------------------------------------------------
# Only required if using private self-hosted course videos instead of YouTube embeds.
# CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# CLOUDFLARE_R2_BUCKET_NAME=your-r2-bucket-name
# CLOUDFLARE_R2_PUBLIC_DOMAIN=https://media.yourdomain.com
